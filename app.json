{
  "expo": {
    "name": "The Modality",
    "slug": "makam",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "makam",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mehmetaydin.makam",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.mehmetaydin.makam"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06060E"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d87be370-d0ea-4766-812a-198ff080b3ac"
      }
    }
  }
}